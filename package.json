{
  "name": "3d-real-estate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Northlight Residences: a 3D real estate landing page (fictional brand, portfolio demo).",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "pnpm dlx serve out",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "steiger": "steiger ./src",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm steiger"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@feature-sliced/steiger-plugin": "0.8.0",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "prettier": "^3.9.10",
    "steiger": "0.8.0",
    "typescript": "5.9.3"
  }
}
